# Development-only POC routes accept transient credentials and are disabled by default.
BOOKORBIT_NOTIFIER_POC_ENDPOINTS_ENABLED=false

# Scheduler runtime is opt-in and expects a database already migrated by Alembic.
BOOKORBIT_NOTIFIER_RUNTIME_ENABLED=false
BOOKORBIT_NOTIFIER_DATABASE_URL=sqlite:///./data/bookorbit-notifier.db
# Optional directory for bounded, allowlisted operational-event logs.
# BOOKORBIT_NOTIFIER_LOG_DIRECTORY=./data/logs
# Provide a dedicated Fernet key only via a deployment secret store, never in this file.
# BOOKORBIT_NOTIFIER_ENCRYPTION_KEY=

# Admin UI is disabled by default. The origin must match the browser address exactly.
BOOKORBIT_NOTIFIER_ADMIN_ENABLED=false
# BOOKORBIT_NOTIFIER_ADMIN_ORIGIN=http://127.0.0.1:8000
# Supply a random setup token of at least 32 characters through a secret store.
# BOOKORBIT_NOTIFIER_SETUP_TOKEN=
